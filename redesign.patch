--- /dev/null
+++ b/styles.css
@@ -0,0 +1,738 @@
+/* ==========================================================================
+   Energieberater Ramirez — styles.css (Quelle)
+   Build: npx lightningcss --minify styles.css -o styles.min.css
+          (oder: python3 build.py)
+   Eine Datei, keine Legacy-Overrides, keine !important-Kaskaden.
+   ========================================================================== */
+
+/* --------------------------------------------------------------------------
+   1. Fonts (selbst gehostet — keine Google-Fonts-Requests, DSGVO-sauber)
+   -------------------------------------------------------------------------- */
+@font-face {
+  font-family: "Inter";
+  src: url("fonts/inter-var.woff2") format("woff2");
+  font-weight: 400 700;
+  font-style: normal;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Source Serif 4";
+  src: url("fonts/source-serif-4-var.woff2") format("woff2");
+  font-weight: 400 700;
+  font-style: normal;
+  font-display: swap;
+}
+
+/* --------------------------------------------------------------------------
+   2. Design-Tokens
+   -------------------------------------------------------------------------- */
+:root {
+  /* Farben */
+  --ink:        #0E2235;   /* Tiefes Nachtblau — Hero, Footer, Honorar-Block */
+  --ink-2:      #163A56;
+  --brand:      #1F4A6B;   /* Markenblau (bestehend) */
+  --brand-soft: #E7EEF5;
+  --accent:     #D9822B;   /* Bernstein — ruhiger als das bisherige Orange */
+  --accent-ink: #B8681C;
+  --accent-soft:#FBF1E6;
+
+  --paper:      #F8F6F1;   /* warmes Off-White für Flächen */
+  --surface:    #FFFFFF;
+  --line:       #E4DED3;
+  --line-2:     #D3CCBF;
+
+  --text:       #182330;
+  --text-2:     #4A5564;
+  --text-3:     #7B8794;
+  --on-dark:    rgba(255, 255, 255, 0.86);
+  --on-dark-2:  rgba(255, 255, 255, 0.64);
+  --on-dark-line: rgba(255, 255, 255, 0.14);
+
+  /* Typografie */
+  --font-sans:  "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --font-serif: "Source Serif 4", Georgia, "Times New Roman", serif;
+
+  /* Maße */
+  --container: 1200px;
+  --gutter: clamp(1.25rem, 4vw, 2.5rem);
+  --radius: 8px;
+  --radius-lg: 14px;
+  --shadow: 0 18px 50px -20px rgba(14, 34, 53, 0.35);
+  --shadow-sm: 0 6px 20px -10px rgba(14, 34, 53, 0.25);
+  --header-h: 80px;
+  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
+}
+
+/* --------------------------------------------------------------------------
+   3. Reset & Basis
+   -------------------------------------------------------------------------- */
+*, *::before, *::after { box-sizing: border-box; }
+
+html {
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+  overscroll-behavior-y: none;
+  overflow-x: hidden;        /* Off-Canvas-Drawer darf keinen horizontalen Scroll erzeugen */
+}
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
+}
+
+body {
+  margin: 0;
+  font-family: var(--font-sans);
+  font-size: 1.0625rem;          /* 17px */
+  line-height: 1.6;
+  color: var(--text);
+  background: var(--surface);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+  font-feature-settings: "kern", "liga", "calt";
+}
+@media (max-width: 768px) { body { font-size: 1rem; } }
+
+img, picture, svg { display: block; max-width: 100%; }
+img { height: auto; }
+a { color: var(--brand); text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
+a:hover { color: var(--ink); }
+strong { font-weight: 600; }
+hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
+ul, ol { padding-left: 1.2em; }
+
+h1, h2, h3, h4 { margin: 0; color: var(--text); }
+h1, h2 {
+  font-family: var(--font-serif);
+  font-weight: 600;
+  letter-spacing: -0.015em;
+  line-height: 1.1;
+  text-wrap: balance;
+}
+h1 { font-size: clamp(2.1rem, 4.2vw, 3.3rem); }
+h2 { font-size: clamp(1.85rem, 3.1vw, 2.6rem); }
+h3 { font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.005em; }
+h4 { font-size: 1rem; font-weight: 600; }
+
+/* Anker nicht unter dem Sticky-Header verschwinden lassen */
+section[id], [id].anchor-offset { scroll-margin-top: calc(var(--header-h) + 1rem); }
+
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }
+::selection { background: var(--accent-soft); color: var(--ink); }
+
+.sr-only {
+  position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
+  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
+}
+.skip-link {
+  position: absolute; left: 1rem; top: -4rem; z-index: 2000;
+  background: var(--ink); color: #fff; padding: 0.6rem 1rem; border-radius: var(--radius);
+  text-decoration: none; font-weight: 600;
+}
+.skip-link:focus { top: 1rem; }
+
+/* --------------------------------------------------------------------------
+   4. Layout-Bausteine
+   -------------------------------------------------------------------------- */
+.container { width: 100%; max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
+.container--narrow { max-width: 860px; }
+
+.section { padding-block: clamp(4rem, 8vw, 7rem); }
+.section--paper { background: var(--paper); }
+.section--dark  { background: var(--ink); color: var(--on-dark); }
+.section--dark h2, .section--dark h3 { color: #fff; }
+.section--line  { border-top: 1px solid var(--line); }
+
+.section-head { max-width: 720px; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
+.section-head--center { margin-inline: auto; text-align: center; }
+.section-head--center .eyebrow { justify-content: center; }
+.section-head--center .eyebrow::before { display: none; }
+
+.eyebrow {
+  display: inline-flex; align-items: center; gap: 0.7rem;
+  margin: 0 0 1rem;
+  font-size: 0.76rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
+  color: var(--accent);
+}
+.eyebrow::before { content: ""; width: 26px; height: 1px; background: currentColor; }
+.section--dark .eyebrow { color: var(--accent); }
+
+.lead { font-size: clamp(1.05rem, 1.35vw, 1.2rem); line-height: 1.6; color: var(--text-2); margin: 1.1rem 0 0; max-width: 62ch; text-wrap: pretty; }
+.section--dark .lead { color: var(--on-dark); }
+
+.two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
+@media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }
+
+/* --------------------------------------------------------------------------
+   5. Buttons & Links
+   -------------------------------------------------------------------------- */
+.btn,
+.cta-button, .primary-button, .back-button, .submit-button, .ghost-button-light {
+  display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
+  padding: 0.85rem 1.45rem;
+  font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; letter-spacing: 0.005em; line-height: 1.2;
+  border-radius: var(--radius); border: 1px solid transparent;
+  text-decoration: none; cursor: pointer; white-space: normal; text-align: center;
+  transition: background-color 0.18s var(--ease), color 0.18s var(--ease), border-color 0.18s var(--ease), transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
+}
+.btn svg { width: 18px; height: 18px; flex: 0 0 auto; }
+
+.btn--primary, .cta-button, .submit-button {
+  background: var(--accent); color: #fff; border-color: var(--accent);
+  box-shadow: 0 8px 20px -10px rgba(217, 130, 43, 0.7);
+}
+.btn--primary:hover, .cta-button:hover, .submit-button:hover,
+.btn--primary:focus-visible, .cta-button:focus-visible, .submit-button:focus-visible {
+  background: var(--accent-ink); border-color: var(--accent-ink); color: #fff; transform: translateY(-1px);
+}
+
+.btn--dark, .primary-button { background: var(--ink); color: #fff; border-color: var(--ink); }
+.btn--dark:hover, .primary-button:hover { background: var(--brand); border-color: var(--brand); color: #fff; }
+
+.btn--outline, .back-button { background: transparent; color: var(--text); border-color: var(--line-2); }
+.btn--outline:hover, .back-button:hover { border-color: var(--ink); color: var(--ink); background: var(--surface); }
+
+.btn--light, .ghost-button-light { background: rgba(255,255,255,0.08); color: #fff; border-color: rgba(255,255,255,0.28); }
+.btn--light:hover, .ghost-button-light:hover { background: rgba(255,255,255,0.16); border-color: rgba(255,255,255,0.5); color: #fff; }
+
+.btn--lg { padding: 1rem 1.7rem; font-size: 1rem; }
+.btn--sm { padding: 0.6rem 1rem; font-size: 0.88rem; }
+
+.link-arrow {
+  display: inline-flex; align-items: center; gap: 0.4rem;
+  font-weight: 600; color: var(--brand); text-decoration: none;
+}
+.link-arrow::after { content: "→"; transition: transform 0.18s var(--ease); }
+.link-arrow:hover::after { transform: translateX(3px); }
+.link-arrow:hover { color: var(--ink); }
+
+/* --------------------------------------------------------------------------
+   6. Header & Navigation
+   -------------------------------------------------------------------------- */
+header.site-header {
+  position: sticky; top: 0; z-index: 1000;
+  background: var(--surface);   /* kein backdrop-filter: würde den fixed Drawer einsperren */
+  border-bottom: 1px solid var(--line);
+}
+.header-inner {
+  max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter);
+  height: var(--header-h);
+  display: flex; align-items: center; justify-content: space-between; gap: 2rem;
+  transition: height 0.25s var(--ease);
+}
+header.header-small .header-inner { height: 66px; }
+
+.logo-link { display: inline-flex; align-items: center; flex: 0 0 auto; }
+.logo { height: 56px; width: auto; transition: height 0.25s var(--ease); }
+header.header-small .logo { height: 46px; }
+
+.header-content { display: flex; align-items: center; gap: 1.75rem; flex: 1; justify-content: flex-end; min-width: 0; }
+
+.site-nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 0.15rem; }
+.site-nav li { position: relative; }
+.site-nav a {
+  display: inline-flex; align-items: center; gap: 0.35rem;
+  padding: 0.55rem 0.8rem; border-radius: 6px;
+  font-size: 0.95rem; font-weight: 500; color: var(--text-2); text-decoration: none;
+  transition: color 0.15s, background-color 0.15s;
+}
+.site-nav a:hover, .site-nav a:focus-visible, .site-nav li.is-active > a { color: var(--ink); background: var(--paper); }
+.site-nav li.has-submenu > a::after {
+  content: ""; width: 7px; height: 7px; margin-left: 0.1rem; margin-top: -3px;
+  border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
+  transform: rotate(45deg); opacity: 0.7;
+}
+.site-nav .submenu {
+  position: absolute; top: calc(100% + 8px); left: 0; min-width: 270px;
+  display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 0.5rem;
+  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
+  box-shadow: var(--shadow);
+  opacity: 0; visibility: hidden; transform: translateY(6px);
+  transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0s linear 0.18s;
+}
+.site-nav .submenu::before { content: ""; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
+.site-nav li.has-submenu:hover > .submenu,
+.site-nav li.has-submenu:focus-within > .submenu { opacity: 1; visibility: visible; transform: translateY(0); transition-delay: 0s; }
+.site-nav .submenu a { display: block; padding: 0.65rem 0.8rem; font-size: 0.92rem; color: var(--text); border-radius: 8px; }
+.site-nav .submenu a small { display: block; font-size: 0.78rem; font-weight: 400; color: var(--text-3); margin-top: 0.1rem; }
+.site-nav .submenu a:hover { background: var(--paper); color: var(--ink); }
+
+.header-actions { display: flex; align-items: center; gap: 0.85rem; }
+.header-phone {
+  display: inline-flex; align-items: center; gap: 0.5rem;
+  font-size: 0.95rem; font-weight: 500; color: var(--text); text-decoration: none;
+  font-variant-numeric: tabular-nums;
+}
+.header-phone svg { width: 16px; height: 16px; stroke: var(--accent); }
+.header-phone:hover { color: var(--brand); }
+.header-actions .btn { padding: 0.7rem 1.15rem; font-size: 0.9rem; }
+
+/* Hamburger */
+.hamburger-menu {
+  display: none; position: relative; z-index: 1300;
+  width: 44px; height: 44px; padding: 10px; margin: 0;
+  background: transparent; border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer;
+}
+.hamburger-line { display: block; flex: 0 0 2px; width: 22px; height: 2px; background: var(--ink); margin: 0; border-radius: 2px; transition: transform 0.25s var(--ease), opacity 0.2s; }
+.hamburger-menu.active .hamburger-line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
+.hamburger-menu.active .hamburger-line:nth-child(2) { opacity: 0; }
+.hamburger-menu.active .hamburger-line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
+
+.mobile-overlay {
+  position: fixed; inset: 0; z-index: 1100;
+  background: rgba(14, 34, 53, 0.55);
+  opacity: 0; visibility: hidden; transition: opacity 0.25s var(--ease), visibility 0s linear 0.25s;
+}
+.mobile-overlay.active { opacity: 1; visibility: visible; transition-delay: 0s; }
+
+@media (max-width: 900px) {
+  :root { --header-h: 68px; }
+  .logo, header.header-small .logo { height: 44px; }
+  .header-inner, header.header-small .header-inner { height: var(--header-h); }
+  .hamburger-menu { display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
+
+  .header-content {
+    position: fixed; top: 0; right: 0; bottom: 0; z-index: 1200;
+    width: min(86vw, 380px);
+    flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 0;
+    padding: calc(var(--header-h) + 0.5rem) 0 1.5rem;
+    background: var(--surface); border-left: 1px solid var(--line);
+    transform: translateX(100%);
+    transition: transform 0.3s var(--ease);
+    overflow-y: auto;
+  }
+  .header-content.active { transform: translateX(0); }
+
+  .site-nav ul { flex-direction: column; align-items: stretch; gap: 0; }
+  .site-nav li { border-bottom: 1px solid var(--line); }
+  .site-nav li:first-child { border-top: 1px solid var(--line); }
+  .site-nav a { padding: 1rem 1.5rem; font-size: 1.05rem; color: var(--text); border-radius: 0; }
+  .site-nav li.has-submenu > a::after { display: none; }
+  .site-nav .submenu {
+    position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none;
+    border: 0; border-radius: 0; padding: 0 0 0.5rem; min-width: 0; background: var(--paper);
+  }
+  .site-nav .submenu li { border: 0; }
+  .site-nav .submenu a { padding: 0.7rem 1.5rem 0.7rem 2.25rem; font-size: 0.95rem; }
+  .site-nav .submenu a small { display: none; }
+
+  .header-actions { flex-direction: column; align-items: stretch; gap: 0.75rem; padding: 1.5rem 1.5rem 0; margin-top: auto; }
+  .header-phone { justify-content: center; padding: 0.8rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); }
+  .header-actions .btn { padding: 0.95rem 1rem; font-size: 1rem; }
+}
+
+/* --------------------------------------------------------------------------
+   7. Hero (Startseite)
+   -------------------------------------------------------------------------- */
+.hero {
+  position: relative; overflow: hidden;
+  background: var(--ink); color: var(--on-dark);
+  padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(4rem, 8vw, 7rem);
+}
+.hero::before {
+  content: ""; position: absolute; inset: 0; pointer-events: none;
+  background:
+    radial-gradient(900px 500px at 85% 10%, rgba(31, 74, 107, 0.55), transparent 60%),
+    radial-gradient(700px 400px at 10% 100%, rgba(217, 130, 43, 0.12), transparent 60%);
+}
+.hero-grid {
+  position: relative;
+  display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
+  gap: clamp(2.5rem, 6vw, 5rem); align-items: center;
+}
+.hero h1 { color: #fff; }
+.hero h1 em { font-style: normal; color: var(--accent); }
+.hero .lead { color: var(--on-dark); }
+.hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
+
+.hero-proof { list-style: none; margin: 2.25rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--on-dark-line); display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1.5rem; }
+.hero-proof li { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.9rem; color: var(--on-dark-2); }
+.hero-proof li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: 0 0 auto; }
+
+.hero-media { position: relative; }
+.hero-media picture, .hero-media img { border-radius: var(--radius-lg); }
+.hero-media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 40%; box-shadow: var(--shadow); }
+.hero-card {
+  position: absolute; left: -1.25rem; bottom: -1.5rem;
+  background: var(--surface); color: var(--text);
+  padding: 1.1rem 1.3rem 1.15rem; border-radius: var(--radius-lg);
+  box-shadow: var(--shadow); max-width: 300px;
+  border-left: 3px solid var(--accent);
+}
+.hero-card-label { display: block; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); }
+.hero-card-value { display: block; font-family: var(--font-serif); font-size: 2.3rem; font-weight: 600; line-height: 1.05; color: var(--ink); margin: 0.25rem 0 0.2rem; }
+.hero-card-note { display: block; font-size: 0.85rem; line-height: 1.45; color: var(--text-2); }
+
+@media (max-width: 900px) {
+  .hero-grid { grid-template-columns: 1fr; }
+  .hero-media { order: -1; }
+  .hero-card { position: relative; left: auto; bottom: auto; z-index: 2; margin: -1.75rem 0 0 1rem; max-width: none; width: calc(100% - 1rem); }
+  .hero-actions .btn { flex: 1 1 auto; }
+  .hero-proof { grid-template-columns: 1fr; }
+}
+
+/* --------------------------------------------------------------------------
+   8. Qualifikationen / Credentials
+   -------------------------------------------------------------------------- */
+.credentials { background: var(--surface); border-bottom: 1px solid var(--line); }
+.credentials-inner {
+  display: grid; grid-template-columns: auto 1fr; align-items: center; gap: clamp(1.5rem, 4vw, 3.5rem);
+  padding-block: 1.75rem;
+}
+.credentials-label { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); white-space: nowrap; }
+.credentials-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem clamp(1.5rem, 4vw, 3.5rem); }
+.credentials-list li { display: flex; align-items: center; gap: 0.9rem; font-size: 0.92rem; color: var(--text-2); line-height: 1.35; }
+.credentials-list img { height: 34px; width: auto; }
+.credentials-list strong { display: block; color: var(--text); font-weight: 600; }
+@media (max-width: 900px) {
+  .credentials-inner { grid-template-columns: 1fr; gap: 1rem; }
+  .credentials-list { flex-direction: column; align-items: flex-start; gap: 1rem; }
+}
+
+/* --------------------------------------------------------------------------
+   9. Leistungen — redaktionelle Liste
+   -------------------------------------------------------------------------- */
+.service-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
+.service-row {
+  display: grid; grid-template-columns: 72px minmax(0, 1.4fr) minmax(0, 1fr) auto;
+  gap: clamp(1rem, 3vw, 2.5rem); align-items: start;
+  padding: 2rem 0; border-bottom: 1px solid var(--line);
+  transition: background-color 0.2s var(--ease);
+}
+.service-row:hover { background: linear-gradient(90deg, var(--paper), transparent 70%); }
+.service-num { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 600; color: var(--accent); line-height: 1; padding-top: 0.2rem; font-variant-numeric: tabular-nums; }
+.service-main h3 { font-size: 1.3rem; margin-bottom: 0.5rem; }
+.service-main h3 a { color: var(--text); text-decoration: none; }
+.service-main h3 a:hover { color: var(--brand); }
+.service-main p { margin: 0; color: var(--text-2); max-width: 52ch; text-wrap: pretty; }
+.service-meta { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 0.9rem; font-size: 0.9rem; align-content: start; padding-top: 0.35rem; }
+.service-meta dt { color: var(--text-3); font-weight: 500; }
+.service-meta dd { margin: 0; color: var(--text); }
+.service-row .link-arrow { padding-top: 0.35rem; white-space: nowrap; }
+@media (max-width: 1024px) {
+  .service-row { grid-template-columns: 56px minmax(0, 1fr); }
+  .service-meta, .service-row .link-arrow { grid-column: 2; }
+}
+@media (max-width: 600px) {
+  .service-row { grid-template-columns: 1fr; gap: 0.75rem; padding: 1.6rem 0; }
+  .service-num { font-size: 1.1rem; }
+  .service-meta, .service-row .link-arrow { grid-column: 1; }
+}
+
+.service-extra {
+  margin-top: clamp(2.5rem, 5vw, 4rem);
+  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(1.5rem, 4vw, 3rem);
+  padding: 2rem; background: var(--paper); border-radius: var(--radius-lg);
+}
+.service-extra h3 { font-size: 1.2rem; }
+.service-extra p { margin: 0.5rem 0 0; color: var(--text-2); font-size: 0.97rem; }
+.chip-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; align-content: start; }
+.chip-list li {
+  padding: 0.45rem 0.8rem; font-size: 0.88rem; font-weight: 500; color: var(--text);
+  background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
+}
+@media (max-width: 800px) { .service-extra { grid-template-columns: 1fr; padding: 1.5rem; } }
+
+/* --------------------------------------------------------------------------
+   10. Warum Ramirez — Portrait + Werte
+   -------------------------------------------------------------------------- */
+.why-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
+.portrait { max-width: 440px; }
+.portrait picture { position: relative; display: block; }
+.portrait picture::before {
+  content: ""; position: absolute; inset: 0; transform: translate(14px, 14px);
+  border: 1px solid var(--accent); border-radius: var(--radius-lg); pointer-events: none; opacity: 0.7;
+}
+.portrait img { position: relative; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: center top; border-radius: var(--radius-lg); background: var(--paper); }
+.portrait-caption {
+  margin-top: 2rem; padding-left: 1rem; border-left: 2px solid var(--accent);
+  font-size: 0.92rem; color: var(--text-2); line-height: 1.5;
+}
+.portrait-caption strong { display: block; color: var(--text); font-size: 1rem; }
+
+.value-list { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1.25rem; }
+.value-list li { display: grid; grid-template-columns: 44px 1fr; gap: 1rem; padding: 1.25rem 0 0; border-top: 1px solid var(--line); }
+.value-list .value-num { font-family: var(--font-serif); font-size: 1.35rem; font-weight: 600; color: var(--accent); line-height: 1.2; }
+.value-list h3 { margin-bottom: 0.3rem; font-size: 1.1rem; }
+.value-list p { margin: 0; color: var(--text-2); font-size: 0.98rem; text-wrap: pretty; }
+.why-cta { margin-top: 2.25rem; display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: center; }
+@media (max-width: 900px) {
+  .why-grid { grid-template-columns: 1fr; }
+  .portrait { max-width: 360px; }
+}
+
+/* Kennzahlen */
+.stats { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); }
+.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
+.stat { padding: 2rem 1.5rem; border-left: 1px solid var(--line); }
+.stat:first-child { border-left: 0; padding-left: 0; }
+.stat-number { display: block; font-family: var(--font-serif); font-size: clamp(2rem, 3.2vw, 2.75rem); font-weight: 600; color: var(--ink); line-height: 1; font-variant-numeric: tabular-nums; }
+.stat-label { display: block; margin-top: 0.5rem; font-size: 0.9rem; color: var(--text-2); }
+@media (max-width: 800px) {
+  .stats-grid { grid-template-columns: repeat(2, 1fr); }
+  .stat { padding: 1.5rem 1rem; border-top: 1px solid var(--line); }
+  .stat:nth-child(-n+2) { border-top: 0; }
+  .stat:nth-child(odd) { border-left: 0; padding-left: 0; }
+}
+
+/* --------------------------------------------------------------------------
+   11. Ablauf
+   -------------------------------------------------------------------------- */
+.steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); counter-reset: step; }
+.step { position: relative; padding-top: 1.5rem; border-top: 1px solid var(--line-2); }
+.step::before {
+  counter-increment: step; content: "0" counter(step);
+  position: absolute; top: -0.85rem; left: 0; padding-right: 0.75rem; background: var(--paper);
+  font-family: var(--font-serif); font-size: 1.35rem; font-weight: 600; color: var(--accent); line-height: 1;
+}
+.step h3 { font-size: 1.12rem; margin: 0.5rem 0 0.5rem; }
+.step p { margin: 0; color: var(--text-2); font-size: 0.97rem; text-wrap: pretty; }
+.step-tag { display: inline-block; margin-top: 0.9rem; padding: 0.25rem 0.6rem; border-radius: 4px; background: var(--surface); border: 1px solid var(--line); font-size: 0.78rem; font-weight: 600; color: var(--brand); letter-spacing: 0.02em; }
+@media (max-width: 1024px) { .steps { grid-template-columns: repeat(2, 1fr); } }
+@media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
+
+/* --------------------------------------------------------------------------
+   12. Honorar & Förderung
+   -------------------------------------------------------------------------- */
+.fact-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--on-dark-line); border: 1px solid var(--on-dark-line); border-radius: var(--radius-lg); overflow: hidden; }
+.fact { background: var(--ink); padding: 1.6rem 1.5rem; }
+.fact-value { display: block; font-family: var(--font-serif); font-size: clamp(1.7rem, 2.6vw, 2.3rem); font-weight: 600; color: #fff; line-height: 1.05; font-variant-numeric: tabular-nums; }
+.fact-label { display: block; margin-top: 0.5rem; font-size: 0.9rem; line-height: 1.45; color: var(--on-dark-2); }
+.fact-note { margin: 1.25rem 0 0; font-size: 0.82rem; color: var(--on-dark-2); }
+.section--dark .btn--primary { box-shadow: none; }
+@media (max-width: 480px) { .fact-grid { grid-template-columns: 1fr; } }
+
+/* --------------------------------------------------------------------------
+   13. Kontakt
+   -------------------------------------------------------------------------- */
+.contact-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
+.contact-details { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
+.contact-details li { display: grid; grid-template-columns: 120px 1fr; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); font-size: 0.97rem; }
+.contact-details dt, .contact-details .dt { color: var(--text-3); font-weight: 500; }
+.contact-details a { color: var(--text); text-decoration: none; font-weight: 500; }
+.contact-details a:hover { color: var(--brand); text-decoration: underline; }
+.contact-note { margin-top: 1.5rem; padding: 1rem 1.1rem; background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: var(--radius); font-size: 0.92rem; color: var(--text-2); }
+.contact-note strong { color: var(--text); }
+@media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } .contact-details li { grid-template-columns: 100px 1fr; } }
+
+.form-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.5rem, 3vw, 2.25rem); box-shadow: var(--shadow-sm); }
+.form-card h3 { font-size: 1.2rem; margin-bottom: 0.35rem; }
+.form-card > p { margin: 0 0 1.5rem; color: var(--text-2); font-size: 0.95rem; }
+.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
+@media (max-width: 560px) { .form-row { grid-template-columns: 1fr; } }
+.form-group { margin-bottom: 1rem; }
+.form-label { display: block; margin-bottom: 0.4rem; font-size: 0.86rem; font-weight: 600; color: var(--text); }
+.form-input {
+  width: 100%; padding: 0.8rem 0.95rem; font: inherit; font-size: 1rem; color: var(--text);
+  background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--radius);
+  transition: border-color 0.15s, box-shadow 0.15s;
+}
+.form-input::placeholder { color: var(--text-3); }
+.form-input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(31, 74, 107, 0.15); }
+.form-input.invalid-input { border-color: #B42318; }
+.form-textarea { min-height: 150px; resize: vertical; }
+.form-consent { display: flex; gap: 0.7rem; align-items: flex-start; font-size: 0.86rem; color: var(--text-2); margin: 0.25rem 0 1.25rem; }
+.form-consent input { margin-top: 0.3rem; accent-color: var(--brand); width: 16px; height: 16px; flex: 0 0 auto; }
+.form-submit { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
+.submit-button { width: 100%; padding: 1rem 1.5rem; font-size: 1rem; }
+@media (min-width: 561px) { .submit-button { width: auto; } }
+.hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
+.error-message { display: none; margin-top: 0.4rem; font-size: 0.85rem; color: #B42318; }
+#status { margin-top: 1rem; font-size: 0.95rem; }
+#status.success-message { color: #1E7D3A; font-weight: 600; }
+#status.error-message { display: block; color: #B42318; font-size: 0.95rem; }
+.loading { width: 22px; height: 22px; border: 2px solid var(--line-2); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+/* --------------------------------------------------------------------------
+   14. FAQ
+   -------------------------------------------------------------------------- */
+.faq-list { border-top: 1px solid var(--line); }
+.faq-item { border-bottom: 1px solid var(--line); }
+.faq-question {
+  list-style: none; cursor: pointer; display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem;
+  padding: 1.35rem 0; font-family: var(--font-serif); font-size: 1.2rem; font-weight: 600; line-height: 1.3; color: var(--text);
+}
+.faq-question::-webkit-details-marker { display: none; }
+.faq-question::after {
+  content: "+"; flex: 0 0 auto; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-2);
+  display: inline-flex; align-items: center; justify-content: center;
+  font-family: var(--font-sans); font-size: 1.1rem; font-weight: 400; color: var(--brand); line-height: 1;
+  transition: transform 0.2s var(--ease), background-color 0.2s;
+}
+.faq-item[open] .faq-question::after { content: "–"; background: var(--brand-soft); }
+.faq-question:hover { color: var(--brand); }
+.faq-answer { padding: 0 0 1.5rem; color: var(--text-2); max-width: 70ch; }
+.faq-answer p { margin: 0 0 0.75rem; }
+.faq-answer p:last-child { margin-bottom: 0; }
+.faq-answer ul { margin: 0.5rem 0 0.75rem; }
+
+/* --------------------------------------------------------------------------
+   15. CTA-Band (Unterseiten)
+   -------------------------------------------------------------------------- */
+.cta-band { background: var(--ink); color: var(--on-dark); }
+.cta-band-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; padding-block: clamp(2.5rem, 5vw, 4rem); }
+.cta-band h2 { color: #fff; font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
+.cta-band p { margin: 0.5rem 0 0; color: var(--on-dark-2); max-width: 52ch; }
+.cta-band-actions { display: flex; gap: 0.85rem; flex-wrap: wrap; }
+
+/* --------------------------------------------------------------------------
+   16. Footer
+   -------------------------------------------------------------------------- */
+footer.site-footer { background: var(--ink); color: var(--on-dark-2); border-top: 1px solid var(--on-dark-line); }
+.footer-grid {
+  display: grid; grid-template-columns: 1.3fr 1fr 1.25fr 0.7fr; gap: clamp(2rem, 4vw, 3.5rem);
+  padding-block: clamp(3rem, 5vw, 4.5rem) 2.5rem;
+}
+.footer-brand .footer-logo-tile { display: inline-block; padding: 0.55rem 0.7rem; background: #fff; border-radius: var(--radius); margin-bottom: 1.1rem; }
+.footer-brand .footer-logo { height: 44px; width: auto; }
+.footer-brand p { margin: 0; font-size: 0.92rem; line-height: 1.6; max-width: 36ch; }
+.footer-brand strong { color: #fff; font-weight: 600; }
+.footer-col h4 { color: #fff; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem; }
+.footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
+.footer-col a { color: var(--on-dark); text-decoration: none; font-size: 0.95rem; }
+.footer-col a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
+.footer-col address { font-style: normal; font-size: 0.95rem; line-height: 1.6; color: var(--on-dark); }
+.footer-bottom { border-top: 1px solid var(--on-dark-line); padding-block: 1.25rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; font-size: 0.85rem; }
+.footer-bottom a { color: var(--on-dark); }
+.footer-bottom a:hover { color: #fff; }
+@media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
+@media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; gap: 2rem; } }
+
+/* --------------------------------------------------------------------------
+   17. Unterseiten (Leistungen, Rechtliches, Blog, 404)
+   -------------------------------------------------------------------------- */
+.page-hero { background: var(--ink); color: var(--on-dark); padding-block: clamp(3rem, 6vw, 5rem); }
+.page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3.1rem); max-width: 22ch; }
+.page-hero .lead { max-width: 62ch; color: var(--on-dark); }
+.page-hero--center { text-align: center; }
+.page-hero--center h1, .page-hero--center .lead { margin-inline: auto; }
+.page-hero--center .eyebrow::before { display: none; }
+.breadcrumb { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem; color: var(--on-dark-2); }
+.breadcrumb a { color: var(--on-dark-2); text-decoration: none; }
+.breadcrumb a:hover { color: #fff; }
+.breadcrumb li + li::before { content: "/"; margin-right: 0.5rem; opacity: 0.5; }
+
+.page { padding-block: clamp(3rem, 6vw, 5rem); }
+.page-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
+.page-grid--single { grid-template-columns: minmax(0, 820px); }
+@media (max-width: 1000px) { .page-grid { grid-template-columns: 1fr; } }
+
+.page-aside { position: sticky; top: calc(var(--header-h) + 1.5rem); display: grid; gap: 1.25rem; }
+.aside-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.5rem; }
+.aside-card h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
+.aside-card p { margin: 0 0 1.1rem; font-size: 0.92rem; color: var(--text-2); }
+.aside-card .btn { width: 100%; }
+.aside-card ul { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.5rem; font-size: 0.92rem; }
+.aside-card ul a { color: var(--text); text-decoration: none; }
+.aside-card ul a:hover { color: var(--brand); text-decoration: underline; }
+.aside-card--nav h3 { margin-bottom: 0.6rem; }
+.aside-card--nav li.is-current a { color: var(--brand); font-weight: 600; }
+
+/* Fließtext */
+.prose { max-width: 72ch; }
+.prose .legal-content { padding-block: 1.75rem; border-top: 1px solid var(--line); }
+.prose .legal-content:first-child { border-top: 0; padding-top: 0; }
+.prose h2 { font-size: clamp(1.5rem, 2.4vw, 1.9rem); margin-bottom: 1rem; }
+.prose h3 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
+.prose p { margin: 0 0 1rem; color: var(--text-2); text-wrap: pretty; }
+.prose p:last-child { margin-bottom: 0; }
+.prose p strong { color: var(--text); }
+.prose ul, .prose ol { margin: 0.5rem 0 1.25rem; padding-left: 0; list-style: none; display: grid; gap: 0.5rem; }
+.prose ul li, .prose ol li { position: relative; padding-left: 1.6rem; color: var(--text-2); }
+.prose ul li::before {
+  content: ""; position: absolute; left: 0; top: 0.62em; width: 10px; height: 10px;
+  border-right: 1.5px solid var(--accent); border-bottom: 1.5px solid var(--accent);
+  transform: translateY(-50%) rotate(-45deg) scale(0.9); transform-origin: center;
+}
+.prose ol { counter-reset: item; }
+.prose ol li::before { counter-increment: item; content: counter(item) "."; position: absolute; left: 0; top: 0; font-family: var(--font-serif); font-weight: 600; color: var(--accent); }
+.prose li strong { color: var(--text); }
+.prose a { color: var(--brand); }
+.prose .section-divider { margin: 1.5rem 0; }
+.prose .contact-info p { margin: 0; color: var(--text); }
+.prose .highlight-box { margin: 1.25rem 0 0; padding: 1rem 1.2rem; background: var(--paper); border-left: 3px solid var(--accent); border-radius: var(--radius); }
+.prose .highlight-box p { margin: 0; }
+.prose table { width: 100%; border-collapse: collapse; font-size: 0.95rem; margin: 0.5rem 0 1.25rem; }
+.prose th, .prose td { text-align: left; padding: 0.7rem 0.6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
+.prose th { font-weight: 600; color: var(--text); font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; }
+.back-navigation { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--line); display: flex; gap: 0.85rem; flex-wrap: wrap; }
+
+/* 404 */
+.notfound { text-align: center; padding-block: clamp(4rem, 10vw, 8rem); }
+.notfound .code { font-family: var(--font-serif); font-size: clamp(4rem, 10vw, 7rem); font-weight: 600; color: var(--line-2); line-height: 1; }
+.notfound h1 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-top: 0.5rem; }
+.notfound p { color: var(--text-2); max-width: 50ch; margin: 1rem auto 2rem; }
+.notfound .btn-row { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; }
+
+/* --------------------------------------------------------------------------
+   18. Werdegang
+   -------------------------------------------------------------------------- */
+.vita-section { padding-block: clamp(3.5rem, 7vw, 6rem); }
+.vita-section--alt { background: var(--paper); }
+.vita-container { max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
+.vita-heading { text-align: center; margin-bottom: 0.75rem; }
+.vita-lead { text-align: center; max-width: 64ch; margin: 0 auto clamp(2rem, 4vw, 3rem); color: var(--text-2); }
+
+.vita-timeline { list-style: none; margin: 0 auto; padding: 0; max-width: 880px; position: relative; }
+.vita-timeline::before { content: ""; position: absolute; top: 0.6rem; bottom: 0.6rem; left: 150px; width: 1px; background: var(--line-2); }
+.vita-item { position: relative; display: grid; grid-template-columns: 150px 1fr; gap: 2rem; padding: 0 0 2rem; }
+.vita-item:last-child { padding-bottom: 0; }
+.vita-item::before { content: ""; position: absolute; left: 145px; top: 0.55rem; width: 11px; height: 11px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--paper); }
+.vita-year { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 600; color: var(--ink); text-align: right; padding-right: 2rem; font-variant-numeric: tabular-nums; line-height: 1.4; }
+.vita-body h3 { font-size: 1.12rem; margin-bottom: 0.35rem; }
+.vita-body p { margin: 0; color: var(--text-2); font-size: 0.97rem; }
+
+.vita-services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
+.vita-service-group { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.75rem 1.75rem 0.75rem; }
+.vita-service-group h3 { font-family: var(--font-serif); font-size: 1.35rem; color: var(--ink); margin-bottom: 0.5rem; }
+.vita-service-group ul { list-style: none; margin: 0; padding: 0; }
+.vita-service-group li { display: grid; gap: 0.2rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
+.vita-service-group li:last-child { border-bottom: 0; }
+.svc-name { font-weight: 600; color: var(--text); }
+a.svc-name { color: var(--brand); text-decoration: none; }
+a.svc-name:hover { text-decoration: underline; text-underline-offset: 3px; }
+.svc-desc { font-size: 0.92rem; color: var(--text-2); line-height: 1.5; }
+
+.vita-skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
+.vita-skill-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.75rem; }
+.vita-skill-card h3 { font-family: var(--font-serif); font-size: 1.35rem; color: var(--ink); margin-bottom: 1rem; }
+.vita-skill-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
+.vita-skill-card li { position: relative; padding-left: 1.5rem; color: var(--text-2); font-size: 0.97rem; }
+.vita-skill-card li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 10px; height: 10px; border-right: 1.5px solid var(--accent); border-bottom: 1.5px solid var(--accent); transform: translateY(-50%) rotate(-45deg) scale(0.9); }
+.vita-skill-card li em { font-style: normal; font-weight: 600; color: var(--text); }
+
+.vita-docs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.9rem; }
+.vita-doc {
+  position: relative; display: grid; gap: 0.2rem; padding: 1rem 1rem 1rem 3rem;
+  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); color: var(--text); text-decoration: none;
+  transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
+}
+.vita-doc::before { content: ""; position: absolute; left: 1rem; top: 1.05rem; width: 18px; height: 22px; background: linear-gradient(135deg, transparent 50%, var(--line) 50%) top right / 7px 7px no-repeat, var(--brand-soft); border-radius: 2px; }
+.vita-doc::after { content: "PDF"; position: absolute; left: 1.05rem; top: 1.65rem; font-size: 7px; font-weight: 700; color: var(--brand); letter-spacing: 0.04em; }
+.vita-doc:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: var(--shadow-sm); color: var(--text); }
+.vita-doc-name { font-weight: 600; font-size: 0.95rem; line-height: 1.3; }
+.vita-doc-hint { font-size: 0.8rem; color: var(--text-3); }
+
+.vita-cta { text-align: center; }
+.vita-cta h2 { margin-bottom: 0.5rem; }
+.vita-cta p { color: var(--text-2); max-width: 56ch; margin: 0 auto 1.75rem; }
+.vita-cta-buttons { display: inline-flex; gap: 0.85rem; flex-wrap: wrap; justify-content: center; }
+
+@media (max-width: 800px) {
+  .vita-timeline::before { left: 5px; }
+  .vita-item { grid-template-columns: 1fr; gap: 0.3rem; padding-left: 2rem; }
+  .vita-item::before { left: 0; top: 0.5rem; }
+  .vita-year { text-align: left; padding: 0; }
+  .vita-services-grid, .vita-skills-grid { grid-template-columns: 1fr; }
+}
+
+/* --------------------------------------------------------------------------
+   19. Print
+   -------------------------------------------------------------------------- */
+@media print {
+  header.site-header, .hamburger-menu, .mobile-overlay, .cta-band, .page-aside, .hero-actions, .form-card { display: none !important; }
+  body { color: #000; font-size: 11pt; }
+  a { color: #000; text-decoration: none; }
+  .hero, .page-hero, footer.site-footer, .section--dark { background: #fff !important; color: #000 !important; }
+  .hero h1, .page-hero h1, .section--dark h2 { color: #000 !important; }
+}
